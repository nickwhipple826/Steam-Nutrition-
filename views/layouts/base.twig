<!doctype html>
<!--suppress HtmlRequiredTitleElement, HtmlRequiredLangAttribute -->
<html {{ site.language_attributes }}>
  <head>
    <meta charset='UTF-8'>
    <meta name='viewport'
          content='width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0'>
    <title>{{ post.acf.seo_metadata.title }}</title>
    {{ function('wp_head') }}
  </head>
  <body {{ function('body_class') }}>
    {{ function('wp_body_open') }}

    <header>
    {% include 'partials/sections/header.twig' %}
    </header>

    <main>
      {% block content %}{% endblock %}
    </main>

    <footer>
  {% include 'partials/sections/footer.twig' %}
    </footer>

    {{ function('wp_footer') }}
  </body>
</html>