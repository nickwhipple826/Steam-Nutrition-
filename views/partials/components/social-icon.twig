{#
  components/social-icon.twig — outline glyphs, drawn to match the
  header icons' 1.7 stroke. Unknown networks fall back to a link icon
  rather than rendering nothing.
#}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
  {% if network == 'instagram' %}
    <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
  {% elseif network == 'tiktok' %}
    <path d="M15 4v10.5a4 4 0 1 1-3.2-3.9"/><path d="M15 6.5c1 1.6 2.5 2.5 4.5 2.6"/>
  {% elseif network == 'youtube' %}
    <rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="m10.5 9.5 5 2.5-5 2.5Z"/>
  {% elseif network == 'facebook' %}
    <path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8a0 0 0 0 1 0 0Z"/>
  {% elseif network == 'x' %}
    <path d="M4 4l16 16M20 4 4 20"/>
  {% else %}
    <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>
  {% endif %}
</svg>
