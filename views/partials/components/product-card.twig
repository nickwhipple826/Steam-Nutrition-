<article class="product-card {{ not product.available ? 'product-card--sold-out' }}">
  <a href="/product/{{ product.handle }}" class="product-card__link">
    <div class="product-card__image">
      <img src="{{ product.image }}" alt="{{ product.alt }}" loading="lazy">
      {% if not product.available %}
        <span class="product-card__badge">Sold Out</span>
      {% endif %}
    </div>
    <h3 class="product-card__title">{{ product.title }}</h3>
    <p class="product-card__price">{{ product.price|number_format(2) }} {{ product.currency }}</p>
  </a>
</article>