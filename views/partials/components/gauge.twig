{#
  components/gauge.twig
  ---------------------------------------------------------------
  One pressure dial. The scale runs 270 degrees clockwise from 7:30 to
  4:30; the needle is rotated by CSS off --v, a 0-1 unitless number, so
  the sweep animation and the resting position stay in agreement.

  The arc endpoints are trigonometry against a centre of 60,60 and a
  radius of 44 — do not nudge them by eye. 28.9/91.1 is 135 degrees,
  91.1/91.1 is 45, and the redline starts at 102.5/71.4, which is 15
  degrees, i.e. the last 30 degrees of travel.
#}
<div class="gauge" style="--v: {{ level }}">
  <svg class="gauge__dial" viewBox="0 0 120 120" role="img"
       aria-label="{{ label|esc_attr }}: {{ value|esc_attr }}">
    <circle cx="60" cy="60" r="56" class="gauge__bezel"/>
    <circle cx="60" cy="60" r="50" class="gauge__inner"/>
    <path d="M28.9 91.1A44 44 0 1 1 91.1 91.1" class="gauge__ticks"/>
    <path d="M102.5 71.4A44 44 0 0 1 91.1 91.1" class="gauge__redline"/>
    <g class="gauge__needle"><path d="M60 60 96 60"/></g>
    <circle cx="60" cy="60" r="6.5" class="gauge__cap"/>
    <circle cx="60" cy="60" r="2.4" class="gauge__pin"/>
  </svg>

  <div class="gauge__value">{{ value|esc_html }}</div>
  <div class="gauge__label">{{ label|esc_html }}</div>

  {% if product %}
    <div class="gauge__product">
      {% if kanji %}<span class="gauge__kanji">{{ kanji|esc_html }}</span>{% endif %}
      {{ product|esc_html }}
    </div>
  {% endif %}
</div>
