<section
  class="plans-reports-policies"
  data-scheme="{{ color }}"
>

  <h2 class="plans-reports-policies__heading">{{ heading|esc_html }}</h2>

  {% if intro %}
    <p class="plans-reports-policies__intro">{{ intro|esc_html }}</p>
  {% endif %}

  <div class="plans-reports-policies__grid">
    {% for item in items %}
      <div class="plans-reports-policies__card">
        <h3 class="plans-reports-policies__title">{{ item.title|esc_html }}</h3>

        {% if item.description %}
          <p class="plans-reports-policies__description">{{ item.description|esc_html }}</p>
        {% endif %}

        {% if item.file.url %}
          <a href="{{ item.file.url }}" class="plans-reports-policies__download" download>
            <svg class="plans-reports-policies__download-icon" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M8 2v8m0 0 3-3M8 10 5 7M2.5 12.5v1a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1v-1" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Download
          </a>
        {% endif %}
      </div>
    {% endfor %}
  </div>

</section>