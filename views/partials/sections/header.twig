{% import 'macros/picture.twig' as picture %}

{#
  header.twig
  ---------------------------------------------------------------------
  Fixed. Transparent over the hero, solid once the page scrolls (see
  ui/header.ts), and the ticker slides up out of the way at the same
  moment so only the 78px bar stays pinned.

  Mega-nav is driven by the Primary menu, three levels deep:

    SUPPLEMENTS            top level  -> the bar item
      Shop                 level two  -> a column heading
        What's new         level three -> a link in that column
        Bundles
      By goal
        Energy & focus

  Level-two items with no children of their own collect into one
  unheaded column, so a plain two-level dropdown still renders sensibly.
  Image cards and column kanji are ACF fields on the menu items
  themselves (MenuItemFields.php), read with menu_item_field().

  The search dialog and the mobile drawer render AFTER .header-wrapper,
  not inside it. The wrapper gets a transform when it goes solid, and a
  transformed ancestor turns position:fixed children into boxes pinned
  to the bar — which is how the old drawer broke once the page had
  been scrolled.
#}

<div class="header-wrapper" data-header>

  {% if site.ticker_items %}
    <div class="ticker" role="region" aria-label="Announcements">
      <div class="ticker__track">
        {% for pass in 1..2 %}
          <ul class="ticker__list"{% if pass == 2 %} aria-hidden="true"{% endif %}>
            {% for line in site.ticker_items %}
              <li class="ticker__item">{{ line|esc_html }}</li>
            {% endfor %}
          </ul>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="site-header">
    <div class="site-header__inner">

      <a class="brand" href="{{ site.url|esc_url }}" rel="home"
         aria-label="{{ site.name|esc_attr }}, home">
        {% if site.nav_logo %}
          <img class="brand__logo" src="{{ site.nav_logo|esc_url }}" alt="">
        {% else %}
          {% include 'views/partials/components/brand-mon.twig' %}
          <span class="brand__words">
            <span class="brand__word brass-face">{{ site.wordmark|esc_html }}</span>
            {% if site.wordmark_sub %}
              <span class="brand__sub">{{ site.wordmark_sub|esc_html }}</span>
            {% endif %}
          </span>
        {% endif %}
      </a>

      <nav class="mega-nav" aria-label="Primary">
        <ul class="mega-nav__list">
          {% for item in menu.items %}
            {% set has_panel = item.children|length > 0 %}

            <li class="mega-nav__item{{ has_panel ? ' has-panel' }}">
              <a class="mega-nav__top"
                 href="{{ item.url|esc_url }}"
                 target="{{ item.target|default('_self')|esc_attr }}"
                 {% if item.current %}aria-current="page"{% endif %}>
                {{ item.title|esc_html }}
              </a>

              {% if has_panel %}
                {% set columns = item.children|filter(c => c.children|length > 0) %}
                {% set loose = item.children|filter(c => c.children|length == 0) %}
                {% set cards = menu_item_field(item.id, 'mega_cards') %}

                <div class="mega-nav__panel">
                  <div class="mega-nav__inner{{ cards ? ' has-cards' }}">

                    {% if loose %}
                      <div class="mega-nav__col">
                        <ul>
                          {% for link in loose %}
                            <li><a href="{{ link.url|esc_url }}"
                                   target="{{ link.target|default('_self')|esc_attr }}">{{ link.title|esc_html }}</a></li>
                          {% endfor %}
                        </ul>
                      </div>
                    {% endif %}

                    {% for col in columns %}
                      {% set col_kanji = menu_item_field(col.id, 'kanji') %}
                      <div class="mega-nav__col">
                        <h4 class="mega-nav__heading">
                          {{ col.title|esc_html }}
                          {% if col_kanji %}<span class="jp">{{ col_kanji|esc_html }}</span>{% endif %}
                        </h4>
                        <ul>
                          {% for link in col.children %}
                            <li><a href="{{ link.url|esc_url }}"
                                   target="{{ link.target|default('_self')|esc_attr }}">{{ link.title|esc_html }}</a></li>
                          {% endfor %}
                        </ul>
                      </div>
                    {% endfor %}

                    {% if cards %}
                      <div class="mega-nav__cards">
                        {% for card in cards %}
                          <a class="mega-card" href="{{ card.link.url|default('#')|esc_url }}"
                             target="{{ card.link.target|default('_self')|esc_attr }}">
                            <span class="mega-card__shot">
                              {% if card.image %}
                                {{ picture.render(card.image, 'medium', '', 'mega-card__img') }}
                              {% endif %}
                            </span>
                            <span class="mega-card__label">{{ card.label|default(card.link.title)|esc_html }}</span>
                          </a>
                        {% endfor %}
                      </div>
                    {% endif %}

                  </div>
                </div>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav>

      <div class="header-icons">
        {# A real link to /search, upgraded to the in-place dialog by ui/search.ts. #}
        <a class="header-icons__link" href="{{ site.search_url|esc_url }}" aria-label="Search"
           data-search-open aria-haspopup="dialog" aria-controls="site-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/>
          </svg>
        </a>
        <a class="header-icons__link header-icons__link--account" href="{{ site.account_url|esc_url }}" aria-label="Account">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>
          </svg>
        </a>
        <a class="header-icons__link header-icons__link--cart" href="{{ site.cart_url|esc_url }}" aria-label="Bag"
           data-cart-open aria-haspopup="dialog">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <path d="M5 8h14l-1.2 12H6.2Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
          </svg>
          {#
            Hidden until ui/cart.ts sets it from the steam_cart_count
            cookie. Never rendered server-side: the header is page-cached,
            so a number here would be someone else's.
          #}
          <span class="header-icons__count" data-cart-count hidden>0</span>
        </a>

        <button type="button" class="nav-toggle" data-nav-toggle
                aria-expanded="false" aria-controls="mobile-nav-panel" aria-haspopup="dialog">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"/>
          </svg>
          <span class="screen-reader-text">Menu</span>
        </button>
      </div>

    </div>
  </div>

</div>

{# =================================================================== #}
{# Search dialog — ui/search.ts                                          #}
{# =================================================================== #}
<div class="site-search" id="site-search" data-search hidden
     data-search-api="{{ function('rest_url', 'steam/v1/search')|esc_url }}">
  <div class="site-search__backdrop" data-search-close></div>

  <div class="site-search__panel" role="dialog" aria-modal="true" aria-label="Search the shop">
    <div class="site-search__inner">

      <form class="search-form site-search__form" role="search" method="get"
            action="{{ site.search_url|esc_url }}" data-search-form>
        <label class="screen-reader-text" for="site-search-input">Search products</label>
        <svg class="search-form__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/>
        </svg>
        <input id="site-search-input" class="search-form__input" type="search" name="q"
               placeholder="Search supplements, apparel, merch…"
               autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search"
               aria-controls="site-search-results" aria-describedby="site-search-status"
               data-search-input>
        <button type="submit" class="search-form__submit">
          <span class="screen-reader-text">Search</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </button>
        <button type="button" class="site-search__close" data-search-close>
          <span class="site-search__close-label">Close</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18"/>
          </svg>
        </button>
      </form>

      <p class="site-search__status" id="site-search-status" aria-live="polite" data-search-status></p>

      <div class="site-search__results" id="site-search-results" data-search-results></div>

      {% if menu.items %}
        <nav class="site-search__browse" aria-label="Browse" data-search-browse>
          <span class="site-search__label">Browse</span>
          <ul>
            {% for item in menu.items %}
              <li><a href="{{ item.url|esc_url }}">{{ item.title|esc_html }}</a></li>
            {% endfor %}
          </ul>
        </nav>
      {% endif %}

    </div>
  </div>
</div>

{# =================================================================== #}
{# Mobile drawer — ui/nav.ts                                             #}
{# =================================================================== #}
<div class="mobile-nav-backdrop" data-nav-backdrop hidden></div>

<div id="mobile-nav-panel" class="mobile-nav-panel" data-nav-panel hidden
     role="dialog" aria-modal="true" aria-label="Menu">

  <div class="mobile-nav-panel__head">
    <a class="mobile-nav-panel__brand" href="{{ site.url|esc_url }}" rel="home">
      {% if site.nav_logo %}
        <img src="{{ site.nav_logo|esc_url }}" alt="{{ site.name|esc_attr }}">
      {% else %}
        <span class="brass-face">{{ site.wordmark|esc_html }}</span>
      {% endif %}
    </a>

    <button type="button" class="mobile-nav-panel__close" data-nav-close>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18"/>
      </svg>
      <span class="screen-reader-text">Close menu</span>
    </button>
  </div>

  <form class="search-form mobile-nav-panel__search" role="search" method="get" action="{{ site.search_url|esc_url }}">
    <label class="screen-reader-text" for="mobile-nav-search">Search products</label>
    <svg class="search-form__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/>
    </svg>
    <input id="mobile-nav-search" class="search-form__input" type="search" name="q"
           placeholder="Search the shop" autocomplete="off" enterkeyhint="search">
    <button type="submit" class="search-form__submit">
      <span class="screen-reader-text">Search</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6"/>
      </svg>
    </button>
  </form>

  <nav class="mobile-nav" aria-label="Primary">
    {% for item in menu.items %}
      {% if item.children|length %}
        <details class="mobile-nav__group" {{ item.current or item.current_item_ancestor ? 'open' }}>
          <summary>
            <span>{{ item.title|esc_html }}</span>
            <span class="mobile-nav__chev" aria-hidden="true"></span>
          </summary>
          <div class="mobile-nav__body">
            <ul>
              <li><a class="mobile-nav__all" href="{{ item.url|esc_url }}">Shop all {{ item.title|lower|esc_html }}</a></li>
              {% for child in item.children %}
                {% if child.children|length %}
                  <li class="mobile-nav__heading">{{ child.title|esc_html }}</li>
                  {% for link in child.children %}
                    <li><a href="{{ link.url|esc_url }}"
                           target="{{ link.target|default('_self')|esc_attr }}"
                           {% if link.current %}aria-current="page"{% endif %}>{{ link.title|esc_html }}</a></li>
                  {% endfor %}
                {% else %}
                  <li><a href="{{ child.url|esc_url }}"
                         target="{{ child.target|default('_self')|esc_attr }}"
                         {% if child.current %}aria-current="page"{% endif %}>{{ child.title|esc_html }}</a></li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        </details>
      {% else %}
        <a class="mobile-nav__single" href="{{ item.url|esc_url }}"
           target="{{ item.target|default('_self')|esc_attr }}"
           {% if item.current %}aria-current="page"{% endif %}>
          <span>{{ item.title|esc_html }}</span>
          <span class="mobile-nav__arrow" aria-hidden="true"></span>
        </a>
      {% endif %}
    {% endfor %}
  </nav>

  <div class="mobile-nav-panel__foot">
    <a class="mobile-nav-panel__action" href="{{ site.account_url|esc_url }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>
      </svg>
      Account
    </a>
    <a class="mobile-nav-panel__action mobile-nav-panel__action--bag" href="{{ site.cart_url|esc_url }}"
       data-cart-open aria-haspopup="dialog">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <path d="M5 8h14l-1.2 12H6.2Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
      </svg>
      Bag
    </a>
  </div>

  {% if site.socials %}
    <ul class="mobile-nav-panel__socials">
      {% for social in site.socials %}
        <li>
          <a href="{{ social.url|esc_url }}" target="_blank" rel="noopener">{{ social.network|capitalize|esc_html }}</a>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>
