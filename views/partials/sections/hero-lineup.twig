{% import 'macros/picture.twig' as picture %}

{#
  The hero sits under a transparent fixed header, so it pulls itself up
  by the header height. See the has-hero body class note in the README —
  without it the header stays solid and the top of this image is hidden.

  Slider anatomy
  ---------------------------------------------------------------------
  __bgs     every slide's background, stacked, crossfaded by is-active
  __stack   every slide's copy, stacked in one grid cell — the cell is
            as tall as the tallest slide, so changing slides never
            moves the stat strip or the controls
  __foot    every slide's stat strip, stacked the same way, plus the
            controls, which stay fixed across slides

  ui/hero-slider.ts drives it. Without JS the first slide simply shows.
#}

{# Content saved before the hero became a slider: render it as slide one. #}
{% set slides = slides|default([]) %}
{% if slides is empty and heading|default %}
  {% set slides = [{
    background: background|default,
    eyebrow: eyebrow|default,
    heading: heading,
    subheading: subheading|default,
    lede: lede|default,
    buttons: buttons|default([]),
    stats: stats|default([]),
  }] %}
{% endif %}

{% set count = slides|length %}
{% set is_slider = count > 1 %}
{% set has_stats = slides|filter(s => s.stats is not empty)|length > 0 %}
{% set interval = (interval|default(7)) * 1000 %}

<section class="hero-lineup{{ is_slider ? ' hero-lineup--slider' }}"
         data-scheme="{{ color|default('iron') }}"
  {%- if is_slider %}
         data-hero-slider
         data-autoplay="{{ (autoplay ?? true) ? interval : 0 }}"
         aria-roledescription="carousel"
         aria-label="Featured"
         style="--hero-interval: {{ interval }}ms"
  {%- endif %}>

  <div class="hero-lineup__bgs" style="--scrim: {{ (scrim|default(90)) / 100 }}">
    {% for slide in slides %}
      <div class="hero-lineup__bg{{ loop.first ? ' is-active' }}" data-hero-bg>
        {{ picture.responsive(
          slide.background,
          ['medium', 'large', 'full'],
          '100vw',
          null,
          'hero-lineup__img',
          loop.first
            ? { loading: 'eager', fetchpriority: 'high' }
            : { loading: 'lazy', fetchpriority: 'low', decoding: 'async' }
        ) }}
      </div>
    {% endfor %}
  </div>

  <div class="hero-lineup__steam" aria-hidden="true"></div>

  <div class="hero-lineup__inner">
    <div class="hero-lineup__grid">
      {% if rail_text %}
        <div class="hero-lineup__gutter" aria-hidden="true">
          <span class="hero-lineup__tate">{{ rail_text|esc_html }}</span>
        </div>
      {% endif %}

      <div class="hero-lineup__main">
        <div class="hero-lineup__stack" {% if is_slider %}aria-live="off"{% endif %}>
          {% for slide in slides %}
            {% set tag = loop.first ? 'h1' : 'h2' %}
            <div class="hero-lineup__copy{{ loop.first ? ' is-active' }}"
                 data-hero-slide
              {%- if is_slider %}
                 role="group"
                 aria-roledescription="slide"
                 aria-label="{{ loop.index }} of {{ count }}"
                 {{ (not loop.first) ? 'inert' }}
              {%- endif %}>

              {% if slide.eyebrow %}
                <span class="eyebrow"><span class="eyebrow__dot"></span>{{ slide.eyebrow|esc_html }}</span>
              {% endif %}

              <{{ tag }} class="hero-lineup__heading brass-face">{{ slide.heading|esc_html }}</{{ tag }}>

              {% if slide.subheading %}
                <div class="hero-lineup__sub">{{ slide.subheading|esc_html }}</div>
              {% endif %}

              {% if slide.lede %}
                <p class="hero-lineup__lede">{{ slide.lede|esc_html }}</p>
              {% endif %}

              {% if slide.buttons %}
                <div class="hero-lineup__cta">
                  {% for row in slide.buttons %}
                    {% if row.button.url %}
                      {% include 'views/partials/components/button.twig' with {
                        label: row.button.title,
                        url: row.button.url,
                        target: row.button.target,
                        variant: loop.first ? 'primary' : 'outline',
                      } %}
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>

        {% if has_stats or is_slider %}
          <div class="hero-lineup__foot">
            {% if has_stats %}
              <div class="hero-lineup__stats-stack">
                {# One per slide, empty or not, so the index lines up with the slides. #}
                {% for slide in slides %}
                  <dl class="hero-lineup__stats{{ loop.first ? ' is-active' }}{{ slide.stats is empty ? ' hero-lineup__stats--empty' }}"
                      data-hero-stats
                      {{ (not loop.first) ? 'aria-hidden="true"' }}>
                    {% for stat in slide.stats %}
                      <div class="hero-lineup__stat">
                        <dt class="hero-lineup__stat-value">{{ stat.value|esc_html }}</dt>
                        <dd class="hero-lineup__stat-label">{{ stat.label|esc_html }}</dd>
                      </div>
                    {% endfor %}
                  </dl>
                {% endfor %}
              </div>
            {% endif %}

            {% if is_slider %}
              <div class="hero-lineup__controls">
                <button type="button" class="rail-nav__btn hero-lineup__toggle" data-hero-toggle
                        aria-label="Pause slideshow" hidden>
                  <svg class="hero-lineup__icon-pause" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M9 6v12M15 6v12"/>
                  </svg>
                  <svg class="hero-lineup__icon-play" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M8 5.5v13l10.5-6.5z"/>
                  </svg>
                </button>

                <button type="button" class="rail-nav__btn" data-hero-dir="-1" aria-label="Previous slide">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M15 5 8 12l7 7"/>
                  </svg>
                </button>

                <div class="hero-lineup__pager">
                  <span class="hero-lineup__count" aria-hidden="true">
                    <span data-hero-current>01</span><span class="hero-lineup__count-sep">/</span>{{ '%02d'|format(count) }}
                  </span>
                  <div class="hero-lineup__ticks">
                    {% for slide in slides %}
                      <button type="button" class="hero-lineup__tick{{ loop.first ? ' is-active' }}"
                              data-hero-goto="{{ loop.index0 }}"
                              aria-label="Go to slide {{ loop.index }}: {{ slide.heading|esc_attr }}"
                              {{ loop.first ? 'aria-current="true"' }}>
                        <span class="hero-lineup__tick-fill"></span>
                      </button>
                    {% endfor %}
                  </div>
                </div>

                <button type="button" class="rail-nav__btn" data-hero-dir="1" aria-label="Next slide">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="m9 5 7 7-7 7"/>
                  </svg>
                </button>
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
