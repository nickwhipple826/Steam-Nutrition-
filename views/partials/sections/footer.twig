{#
  footer.twig
  ---------------------------------------------------------------------
  Columns come from the Footer menu, two levels deep: each top-level
  item is a column heading, its children are the links. A flat Footer
  menu (no children anywhere) renders as a single unheaded column.

  The legal row reads the Legal menu. Everything else is Site Settings.
#}

<footer class="site-footer">
  <div class="site-footer__inner">

    <div class="site-footer__brand">
      <a class="brand" href="{{ site.url|esc_url }}" rel="home"
         aria-label="{{ site.name|esc_attr }}, home">
        {% if site.footer_logo %}
          <img class="brand__logo" src="{{ site.footer_logo|esc_url }}" alt="">
        {% else %}
          {% include 'views/partials/components/brand-mon.twig' %}
          <span class="brand__words">
            <span class="brand__word brass-face">{{ site.wordmark|esc_html }}</span>
            {% if site.wordmark_sub %}
              <span class="brand__sub">{{ site.wordmark_sub|esc_html }}</span>
            {% endif %}
          </span>
        {% endif %}
      </a>

      {% if site.footer_tagline %}
        <p class="site-footer__tagline">{{ site.footer_tagline|esc_html }}</p>
      {% endif %}

      {% if site.socials %}
        <ul class="site-footer__socials">
          {% for social in site.socials %}
            <li>
              <a href="{{ social.url|esc_url }}" target="_blank" rel="noopener"
                 aria-label="{{ social.network|capitalize|esc_attr }}">
                {% include 'views/partials/components/social-icon.twig' with { network: social.network } only %}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if site.locale_label %}
        <div class="site-footer__locale">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/>
            <path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18"/>
          </svg>
          {{ site.locale_label|esc_html }}
        </div>
      {% endif %}
    </div>

    {% if footer_menu and footer_menu.items %}
      {% set nested = footer_menu.items|filter(i => i.children|length > 0) %}

      {% if nested %}
        {% for col in footer_menu.items %}
          {% set col_kanji = menu_item_field(col.id, 'kanji') %}
          <div class="site-footer__col">
            <h5 class="site-footer__heading">
              {{ col.title|esc_html }}
              {% if col_kanji %}<span class="jp">{{ col_kanji|esc_html }}</span>{% endif %}
            </h5>
            <ul>
              {% for link in col.children %}
                <li><a href="{{ link.url|esc_url }}"
                       target="{{ link.target|default('_self')|esc_attr }}">{{ link.title|esc_html }}</a></li>
              {% endfor %}
            </ul>
          </div>
        {% endfor %}
      {% else %}
        <div class="site-footer__col">
          <ul>
            {% for link in footer_menu.items %}
              <li><a href="{{ link.url|esc_url }}"
                     target="{{ link.target|default('_self')|esc_attr }}">{{ link.title|esc_html }}</a></li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    {% endif %}

  </div>

  <div class="site-footer__legal">
    <div class="site-footer__legal-inner">
      <p class="site-footer__disclaimer">
        {% if site.disclaimer %}{{ site.disclaimer|esc_html }} {% endif %}
        &copy; {{ "now"|date("Y") }} {{ site.name|esc_html }}.
      </p>

      <nav class="site-footer__legal-nav" aria-label="Legal">
        {% if legal_menu and legal_menu.items %}
          {% for link in legal_menu.items %}
            <a href="{{ link.url|esc_url }}">{{ link.title|esc_html }}</a>
          {% endfor %}
        {% endif %}
        <a href="https://mcguinnessmedia.com/" target="_blank" rel="noopener">Site by McGuinness Media</a>
      </nav>
    </div>
  </div>
</footer>
