{% set form_id = 'news-' ~ (heading|slugify) %}

<section class="section newsletter-band" data-scheme="{{ color|default('soot') }}">
  <div class="section__inner newsletter-band__inner">
    {% include 'views/partials/components/seal.twig' with { text: seal } only %}

    <h2 class="brass-face">{{ heading|esc_html }}</h2>
    {% if note %}<p class="section__note">{{ note|esc_html }}</p>{% endif %}

    {#
      Welcome offer on (Site Settings → Welcome Offer) and no Form Action
      URL of its own: the form signs up through the theme and gets back a
      one-time code (Shopify\NewsletterApi). A section with its own
      Form Action URL keeps posting there, untouched.
    #}
    {% set welcome = site.welcome_enabled and not action %}

    {% if welcome %}
      <p class="newsletter-band__offer"><span class="eyebrow__dot"></span>{{ site.welcome_offer|esc_html }}</p>
    {% endif %}

    <form class="newsletter-band__form"
          id="{{ form_id }}"
          data-newsletter
          data-success="{{ success_message|esc_attr }}"
          {% if welcome %}
            data-newsletter-api="{{ function('rest_url', 'steam/v1/newsletter')|esc_url }}"
          {% elseif action %}
            action="{{ action|esc_url }}" method="post"
          {% endif %}
          novalidate>
      <label class="screen-reader-text" for="{{ form_id }}-email">Email address</label>
      <input type="email"
             id="{{ form_id }}-email"
             name="{{ welcome ? 'email' : field_name|default('email')|esc_attr }}"
             placeholder="{{ placeholder|default('you@example.com')|esc_attr }}"
             autocomplete="email"
             required>

      {% if welcome %}
        {# Honeypot. Hidden from people and screen readers; bots fill it in. #}
        <div class="newsletter-band__trap" aria-hidden="true">
          <label for="{{ form_id }}-company">Company</label>
          <input type="text" id="{{ form_id }}-company" name="company" tabindex="-1" autocomplete="off">
        </div>
      {% endif %}

      <button class="button" type="submit">{{ button_label|default('Sign up')|esc_html }}</button>
    </form>

    {% if welcome %}
      <div class="newsletter-band__reward" data-newsletter-reward hidden>
        <p class="newsletter-band__reward-label">Your code · {{ site.welcome_offer|esc_html }}</p>
        <div class="newsletter-band__code">
          <span class="newsletter-band__code-text" data-newsletter-code></span>
          <button type="button" class="newsletter-band__copy" data-newsletter-copy>Copy</button>
        </div>
      </div>
    {% endif %}

    <p class="newsletter-band__status" role="status" data-newsletter-status></p>

    {% if fine_print %}
      <p class="newsletter-band__fine">{{ fine_print|esc_html }}</p>
    {% endif %}
  </div>
</section>
