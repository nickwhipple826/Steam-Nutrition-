<section class="notice-listing" data-scheme="{{ color }}">

  <h2 class="notice-listing__heading">{{ heading|esc_html }}</h2>

  {% if description %}
    <p class="notice-listing__description">{{ description|esc_html }}</p>
  {% endif %}

  <div class="notice-listing__grid">
    {% for notice in recent_notices(3) %}
    <div class="notice-listing__card">
      <p class="notice-listing__date">{{ notice.date('F j, Y') }}</p>
      <h3 class="notice-listing__name">{{ notice.title|esc_html }}</h3>
      <div class="notice-listing__excerpt">
        {{ notice.preview.length(12).read_more(false) }}
      </div>
      <a href="{{ notice.link }}" class="notice-listing__more-info">
        More Info
        <svg class="notice-listing__more-info-icon" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M3 8h9.5M8.5 3.5 13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
    {% endfor %}
  </div>

  {% if button.url %}
    <div class="notice-listing__button-wrap">
      {% include 'views/partials/components/button.twig' with {
        label: button.title,
        url: button.url,
        target: button.target,
      } %}
    </div>
  {% endif %}

</section>