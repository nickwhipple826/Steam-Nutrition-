{#
  sections/tiers.twig
  ---------------------------------------------------------------------
  Rank cards. The dial climbs with each card: the first reads a third
  of the way round, the last reads full.
#}
<section class="section tiers" data-scheme="{{ color|default('iron') }}">
  <div class="section__inner">
    {% include 'views/partials/components/rail-tag.twig' with { text: rail_text } %}
    {% include 'views/partials/components/section-head.twig' %}

    <ol class="tiers__list" style="--count: {{ tiers|length }}">
      {% for tier in tiers %}
        <li class="tier{{ tier.flag ? ' tier--flagged' }}">
          {% if tier.flag %}<span class="tier__flag">{{ tier.flag|esc_html }}</span>{% endif %}

          {% include 'views/partials/components/dial.twig' with {
            level: 0.34 + 0.66 * (loop.index0 / max(loop.length - 1, 1))
          } only %}

          <h3 class="tier__name">
            {% if tier.kanji %}<span class="tier__kanji" lang="ja">{{ tier.kanji|esc_html }}</span>{% endif %}
            {{ tier.name|esc_html }}
          </h3>
          {% if tier.range %}<p class="tier__range">{{ tier.range|esc_html }}</p>{% endif %}

          {% set perks = tier.perks|split("\n")|map(p => p|trim)|filter(p => p) %}
          {% if perks %}
            <ul class="tier__perks">
              {% for perk in perks %}<li>{{ perk|esc_html }}</li>{% endfor %}
            </ul>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  </div>
</section>
